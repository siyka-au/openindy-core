---
# C++ Core Guidelines are the style rule set. Checks disabled below are
# deliberate, with the reason given.
Checks: >
  -*,
  cppcoreguidelines-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-loop-convert,
  modernize-use-nodiscard,
  modernize-use-using,
  modernize-make-unique,
  modernize-make-shared,
  misc-throw-by-value-catch-by-reference,
  -cppcoreguidelines-non-private-member-variables-in-classes
# owning-memory: enabled (test/.clang-tidy turns it off for the tests).
# magic-numbers: enabled (test/.clang-tidy turns it off for the tests).
# macro-usage: the OI_DECLARE_PLUGIN* entry-point macros are the only ones left
#   in include/ and src/ (one NOLINT with the reason at the definition).
# Anchored on the checkout directory name (CI checks the repo out as
# openindy-core), so the sibling repos' and third-party headers are not linted.
# sha256.h is being replaced by a library; its findings are not ours to fix.
ExcludeHeaderFilterRegex: '.*/openindy-core/src/codec/sha256\.h'
WarningsAsErrors: ''
HeaderFilterRegex: '.*/openindy-core/(include|src|tools|test)/.*'
# FormatStyle: clang-tidy formats the code its --fix fix-its produce with the
# .clang-format found above the source file; it does not change what is reported.
FormatStyle: file
